module;
#include <cstdlib>
#include <spdlog/spdlog.h>

#include "svl_config.hxx"
export module svl;

import svl.platform;
export import svl.renderer;

export namespace svl
{
int run()
{
    using namespace svl;
    platform::window::context core_window(
        constants::appdata::title, 480, 360, 0);

    core_window.create({}, { "VK_KHR_wayland_surface", "VK_KHR_surface" });

    while (core_window.is_running())
    {
        core_window.poll_event();
    }
    return EXIT_SUCCESS;
}
} // namespace svl