module;
#include <spdlog/spdlog.h>
export module svl.renderer.device;

import vulkan;
import std;

namespace svl::renderer::device
{
class gpu
{
public:
    gpu(vk::raii::PhysicalDevice& physical_device)
        : pd(std::move(physical_device))
    {
        props = vk::raii::PhysicalDevice::getProperties2<
            vk::PhysicalDeviceProperties2>(pd);
        features =
            vk::raii::PhysicalDevice::getFeatures2<vk::PhysicalDeviceFeatures2>(
                pd);
        mem_props = vk::raii::PhysicalDevice::getMemoryProperties2<
            vk::PhysicalDeviceMemoryProperties2>(pd);
    }
    ~gpu() { device.destroy(); }

    std::string get_name()
    {
        p = vk::StructureChain::get<vk::PhysicalDeviceProperties2>(props);
        return p.properties.deviceName;
    }

    void create(const vk::DeviceCreateInfo& device_create_info)
    {
        device = vk::raii::Device(pd, device_create_info);
    }

private:
    vk::StructureChain<vk::PhysicalDeviceProperties2>       props {};
    vk::StructureChain<vk::PhysicalDeviceFeatures2>         features {};
    vk::StructureChain<vk::PhysicalDeviceMemoryProperties2> mem_props {};

    vk::raii::PhysicalDevice pd;
    vk::raii::Device         device;
};

export class manager
{
public:
    manager()                      = delete;
    manager(const manager&)        = delete;
    ~manager()                     = default;
    void operator=(const manager&) = delete;

    static void init(const vk::raii::Instance&       vk_instance,
                     const vk::raii::SurfaceKHR&     vk_surface,
                     const std::vector<std::string>& requested_extensions)
    {
        std::scoped_lock lock(mutex);
        if (instance)
        {
            throw std::runtime_error("Device Manager already initialized");
        }
        instance = new manager(vk_instance, vk_surface, requested_extensions);
    }

    [[nodiscard]] static const manager* get_instance() noexcept
    {
        return instance;
    }

    [[nodiscard]] std::vector<std::string> get_avaliable() const noexcept
    {
        return gpus | std::views::keys;
    }
    void create(const std::string&          pd_name,
                const vk::DeviceCreateInfo& device_create_info)
    {
        if (gpus.contains(pd_name))
        {
            throw std::invalid_argument(
                std::format("Device with name {} not found.", pd_name));
        }

        physical_devices[pd_name].create(device_create_info);

        spdlog::info("Created vk::Device: {} {} ({}) - Vulkan {}",
                     pd_properties[index].properties.deviceName.data(),
                     pd_properties[index].properties.vendorID,
                     pd_properties[index].properties.deviceID,
                     pd_properties[index].properties.apiVersion);
    }
    // void remove(const std::string& pd_name) {}

private:
    explicit manager(const vk::raii::Instance&       vk_instance,
                     const vk::raii::SurfaceKHR&     vk_surface,
                     const std::vector<std::string>& requested_extensions)
    {
        vk::raii::PhysicalDevices physical_devices =
            vk::raii::PhysicalDevices(vk_instance);

        for (vk::raii::PhysicalDevice pd : physical_devices)
        {
            gpu g              = gpu(pd);
            gpus[g.get_name()] = g;
        }
    }

    static std::mutex mutex;
    static manager*   instance = nullptr;

    std::unordered_map<std::string, gpu> gpus;
};

} // namespace svl::renderer::device