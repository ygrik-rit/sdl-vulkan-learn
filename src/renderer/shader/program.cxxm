module;
#include <glslang/Public/ResourceLimits.h>
#include <glslang/Public/ShaderLang.h>
#include <glslang/SPIRV/GlslangToSpv.h>
#include <libassert/assert-macros.hpp>
#include <spdlog/spdlog.h>

#include "svl_config.hxx"
export module svl.renderer.shader;

import svl.utils;

import vulkan;
import libassert;

export namespace svl::renderer::shader
{

class program final
{
public:
    enum class language
    {
        Vertex         = EShLanguage::EShLangVertex,
        TessControl    = EShLanguage::EShLangTessControl,
        TessEvaluation = EShLanguage::EShLangTessEvaluation,
        Geometry       = EShLanguage::EShLangGeometry,
        Fragment       = EShLanguage::EShLangFragment,
        Compute        = EShLanguage::EShLangCompute,
        RayGen         = EShLanguage::EShLangRayGen,
        RayGenNV       = EShLanguage::EShLangRayGenNV,
        Intersect      = EShLanguage::EShLangIntersect,
        IntersectNV    = EShLanguage::EShLangIntersectNV,
        AnyHit         = EShLanguage::EShLangAnyHit,
        AnyHitNV       = EShLanguage::EShLangAnyHitNV,
        ClosestHit     = EShLanguage::EShLangClosestHit,
        ClosestHitNV   = EShLanguage::EShLangClosestHitNV,
        Miss           = EShLanguage::EShLangMiss,
        MissNV         = EShLanguage::EShLangMissNV,
        Callable       = EShLanguage::EShLangCallable,
        CallableNV     = EShLanguage::EShLangCallableNV,
        Task           = EShLanguage::EShLangTask,
        TaskNV         = EShLanguage::EShLangTaskNV,
        Mesh           = EShLanguage::EShLangMesh,
        MeshNV         = EShLanguage::EShLangMeshNV,
        Count          = EShLanguage::EShLangCount,
    };

    explicit program() = default;

    [[nodiscard]] std::vector<char> glsl_to_spirv(
        const std::filesystem::path& path,
        const language               lang,
        const std::string&           entry_point) const
    {
        static bool glslang_initialized = false;
        if (!glslang_initialized)
        {
            glslang::InitializeProcess();
            glslang_initialized = true;
        }

        std::error_code fs_err;
        if (!std::filesystem::is_regular_file(path, fs_err))
        {
            throw std::invalid_argument(
                std::format("Path {} is not regular file: {}",
                            path.c_str(),
                            fs_err.message()));
        }
        std::string   data;
        std::ifstream file(path);
        file.seekg(0, std::ios::end);
        data.resize(static_cast<std::size_t>(file.tellg()));
        file.seekg(0, std::ios::beg);
        file.read(data.data(), static_cast<std::streamsize>(data.size()));

        glslang::TShader tshader(static_cast<EShLanguage>(lang));
        const char*      glsl_str = data.data();
        tshader.setStrings(&glsl_str, 1);
        glslang::EshTargetClientVersion client_version =
            glslang::EShTargetVulkan_1_4;
        glslang::EShTargetLanguageVersion lang_version =
            glslang::EShTargetSpv_1_4;
        tshader.setEnvInput(glslang::EShSourceGlsl,
                            static_cast<EShLanguage>(lang),
                            glslang::EShClientVulkan,
                            450);
        tshader.setEnvClient(glslang::EShClientVulkan, client_version);
        tshader.setEnvTarget(glslang::EShTargetSpv, lang_version);
        tshader.setEntryPoint(entry_point.c_str());
        tshader.setSourceEntryPoint(entry_point.c_str());

        const TBuiltInResource* resources = GetDefaultResources();
        const auto              messages  = static_cast<EShMessages>(
            EShMsgDefault | EShMsgSpvRules | EShMsgVulkanRules |
            EShMsgDebugInfo | EShMsgReadHlsl);

        glslang::TShader::ForbidIncluder includer;

        std::string preprocessed_glsl;
        if (!tshader.preprocess(resources,
                                450,
                                ENoProfile,
                                false,
                                false,
                                messages,
                                &preprocessed_glsl,
                                includer))
        {
            spdlog::info("Preprocessing failed for shader:\n{}\n{}\n{}",
                         data,
                         tshader.getInfoLog(),
                         tshader.getInfoDebugLog());
            ASSERT(false, "Shader preprocess failed");
            return {};
        }
        const char* preprocessed_glsl_str = preprocessed_glsl.data();
        tshader.setStrings(&preprocessed_glsl_str, 1);

        if (!tshader.parse(
                resources, 450, ENoProfile, false, false, messages, includer))
        {
            spdlog::info("Parse failed for shader:\n{}\n{}\n{}",
                         preprocessed_glsl,
                         tshader.getInfoLog(),
                         tshader.getInfoDebugLog());
            ASSERT(false, "Shader parse failed");
            return {};
        }

        glslang::SpvOptions options;

        if constexpr (constants::is_debug_build)
        {
            tshader.setDebugInfo(true);
            options.generateDebugInfo = true;
            options.disableOptimizer  = true;
            options.optimizeSize      = false;
            options.stripDebugInfo    = false;
        }
        else
        {
            options.disableOptimizer = true;
            // this ensure that variables that aren't
            // used in shaders are not removed, without this flag, SPIRV
            // generated will be optimized & unused variables will be removed,
            // this will cause issues in debug vs release if struct on cpu vs
            // gpu are different
            options.optimizeSize   = true;
            options.stripDebugInfo = true;
        }

        glslang::TProgram program;
        program.addShader(&tshader);
        if (!program.link(messages))
        {
            spdlog::info("Parsing failed for shader:\n{}\n{}",
                         program.getInfoLog(),
                         program.getInfoDebugLog());
            ASSERT(false, "link failed");
        }

        std::vector<uint32_t> spirv_data;
        spv::SpvBuildLogger   spv_logger;

        glslang::GlslangToSpv(
            *program.getIntermediate(static_cast<EShLanguage>(lang)),
            spirv_data,
            &spv_logger,
            &options);

        std::vector<char> bytecode;
        bytecode.resize(spirv_data.size() * (sizeof(uint32_t) / sizeof(char)));
        std::memcpy(bytecode.data(), spirv_data.data(), bytecode.size());

        return bytecode;
    }
};
} // namespace svl::renderer::shader