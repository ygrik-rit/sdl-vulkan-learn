{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile.ArchLinux"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"llvm-vs-code-extensions.vscode-clangd",
				"vadimcn.vscode-lldb",
				"llvm-vs-code-extensions.lldb-dap",
				"xaver.clang-format",
				"twxs.cmake",
				"ms-vscode.cmake-tools",
				"cheshirekow.cmake-format",
				"josetr.cmake-language-support-vscode",
				"SonarSource.sonarlint-vscode",
				"dtoplak.vscode-glsllint"
			],
			"settings": {
				"sonarlint.pathToCompileCommands": "${workspaceFolder}/compile_commands.json",
				"sonarlint.connectedMode.project": {
					"connectionId": "ygrik-rit",
					"projectKey": "ygrik-rit_sdl-vulkan-learn"
				},
				"cmake.debugConfig": {
					"type": "lldb",
					"MIMode": "lldb"
				},
				"glsllint.glslangValidatorArgs": [
					"-V"
				],
				"clangd.arguments": [
					"--experimental-modules-support"
				],
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"zsh": {
						"path": "zsh"
					}
				}
			}
		}
	},
	"containerUser": "svl", // Убедитесь, что этот пользователь есть в контейнере
	"remoteUser": "svl",
	"runArgs": [
		"--device=/dev/dri",
		"--device=/dev/snd",
		"--env=WAYLAND_DISPLAY=${localEnv:WAYLAND_DISPLAY}",
		"--env=XDG_RUNTIME_DIR=${localEnv:XDG_RUNTIME_DIR}",
		"--env=DISPLAY=${localEnv:DISPLAY}",
		"--env=PIPEWIRE_RUNTIME_DIR=/tmp",
		"--network=host"
	],
	"mounts": [
		"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
		"source=${localEnv:XDG_RUNTIME_DIR},target=${localEnv:XDG_RUNTIME_DIR},type=bind",
		"source=${localEnv:XDG_RUNTIME_DIR}/pipewire-0,target=/tmp/pipewire-0,type=bind"
	]
}